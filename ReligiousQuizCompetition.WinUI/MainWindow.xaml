<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ReligiousQuizCompetitionWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ReligiousQuizCompetitionWinUI"
    xmlns:services="using:ReligiousQuizCompetitionWinUI.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:convertors="using:ReligiousQuizCompetitionWinUI.Convertors"
    mc:Ignorable="d">
    
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <TitleBar
            x:Name="quizAppTitlebar"
            IsBackButtonVisible="True"
            BackRequested="OnBackRequested">
            <TitleBar.Content>
                <StackPanel 
                    Margin="120, 0, 0, 0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
                    <TextBlock Text="Quiz App" 
                       FontWeight="SemiBold" 
                       FontSize="13" 
                       VerticalAlignment="Center" />
                </StackPanel>
            </TitleBar.Content>
            <TitleBar.LeftHeader>
                <StackPanel 
                    Orientation="Horizontal"
                    Padding="15, 5, 0, 0">
                    <Button 
                        Visibility="{x:Bind HideIfLoggedIn(services:UserStateManager.IsLoggedIn), Mode=OneWay}"
                        Content="سجل دخول" 
                        Click="OnLoginButtonClicked" />
                    <Button 
                        Visibility="{x:Bind ShowIfLoggedIn(services:UserStateManager.IsLoggedIn), Mode=OneWay}"
                        Content="سجل خروج"
                        Command="{x:Bind ViewModel.LogoutCommand}" />
                </StackPanel>
            </TitleBar.LeftHeader>
        </TitleBar>

        <Frame
            FlowDirection="RightToLeft"
            Grid.Row="1"
            x:Name="rootFrame" />
    </Grid>
</Window>
