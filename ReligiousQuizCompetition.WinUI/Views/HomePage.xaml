<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ReligiousQuizCompetitionWinUI.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ReligiousQuizCompetitionWinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ReligiousQuizCompetitionWinUI.ViewModels"
    mc:Ignorable="d">

    <Grid
        Padding="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid
            Visibility="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
            CornerRadius="12"
            Background="Goldenrod"
            Margin="10"
            Padding="20">
            <TextBlock
                Foreground="White"
                HorizontalAlignment="Center"
                FontWeight="Bold"
                FontSize="20"
                Text="مراكز المتسابقين" />
            <Button 
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Content="تحقق من مركزك" 
                Click="OnRanksButtonClicked" 
                Background="DarkGoldenrod" />
        </Grid>
        <Grid
            Visibility="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
            CornerRadius="12"
            Background="#6D9A88"
            Grid.Column="1"
            Margin="10"
            Padding="20">
            <TextBlock
                Foreground="White"
                HorizontalAlignment="Center"
                FontWeight="Bold"
                FontSize="20"
                Text="اعلى درجة تم الحصول عليها" />
            <TextBlock
                Foreground="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="18"
                Text="{x:Bind ViewModel.HighestScore, Mode=OneWay}" />
        </Grid>
        <Grid
            Visibility="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
            Background="#0090f0"
            CornerRadius="12"
            Grid.Column="2"
            Margin="10"
            Padding="20">
            <TextBlock
                Foreground="White"
                HorizontalAlignment="Center"
                FontWeight="Bold"
                FontSize="20"
                Text="المسابقة" />
            <Button 
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Content="دخول"
                Click="OnQuizButtonClicked" 
                Background="#0070f0" />
        </Grid>
        <Grid
            Grid.ColumnSpan="3"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
            <ProgressRing
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                IsIndeterminate="True" />
        </Grid>
    </Grid>
</Page>
