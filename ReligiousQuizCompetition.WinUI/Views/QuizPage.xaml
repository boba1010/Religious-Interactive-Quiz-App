<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ReligiousQuizCompetitionWinUI.Views.QuizPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ReligiousQuizCompetitionWinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dtos="using:ReligiousQuizCompetition.Shared.DTOs"
    xmlns:templates="using:ReligiousQuizCompetitionWinUI.Templates"
    xmlns:converters="using:ReligiousQuizCompetitionWinUI.Convertors"
    xmlns:vm="using:ReligiousQuizCompetitionWinUI.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>

        <DataTemplate x:Key="MultipleChoiceTemplate" x:DataType="dtos:QuestionDTO">
            <StackPanel>
                <TextBlock Text="{x:Bind QuestionName}" />
                <RadioButtons ItemsSource="{x:Bind Choices}" SelectedItem="{x:Bind Answer, Mode=TwoWay}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="WrittenTemplate" x:DataType="dtos:QuestionDTO">
            <StackPanel>
                <TextBlock Text="{x:Bind QuestionName}" />
                <TextBox PlaceholderText="اجابتك..." Text="{x:Bind Answer, Mode=TwoWay}" />
            </StackPanel>
        </DataTemplate>

        <templates:QuestionTemplateSelector x:Key="QuestionSelector" 
                                        MultipleQuestionTemplate="{StaticResource MultipleChoiceTemplate}" 
                                        WrittenTemplate="{StaticResource WrittenTemplate}" />
    </Page.Resources>


    <Grid>
        <Grid
            Visibility="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
            Padding="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListView
                SelectionMode="None"
                ItemsSource="{x:Bind ViewModel.Quiz.Questions}" 
                ItemTemplateSelector="{StaticResource QuestionSelector}" />
            <Button 
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Content="ارسال" 
                Command="{x:Bind ViewModel.SubmitQuizCommand, Mode=OneWay}" />
        </Grid>
        <Grid
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
            <ProgressRing
                IsActive="{x:Bind ViewModel.IsBusy}"
                IsIndeterminate="True" />
        </Grid>
    </Grid>
</Page>
