<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ReligiousQuizCompetitionWinUI.Views.SignupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ReligiousQuizCompetitionWinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ReligiousQuizCompetitionWinUI.ViewModels"
    mc:Ignorable="d">

    <Grid
        Padding="10"
        RowSpacing="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Visibility="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
            VerticalAlignment="Center"
            Spacing="15">
            <TextBox 
                Style="{StaticResource StretchTextBoxStyle}"
                PlaceholderText="ادخل اسمك"
                Text="{x:Bind ViewModel.RequestUserSignup.FullName, Mode=TwoWay}" />
            <TextBox
                Style="{StaticResource StretchTextBoxStyle}"
                PlaceholderText="انشئ اسم مستخدم جديد"
                Text="{x:Bind ViewModel.RequestUserSignup.Username, Mode=TwoWay}" />
            <TextBox 
                Style="{StaticResource StretchTextBoxStyle}"
                PlaceholderText="انشئ كلمة مرور جديدة"
                Text="{x:Bind ViewModel.RequestUserSignup.Password, Mode=TwoWay}" />            
        </StackPanel>

        <StackPanel
            Visibility="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
            Spacing="10"
            VerticalAlignment="Bottom"
            Grid.Row="1">
            <Button 
                Style="{StaticResource StretchButtonStyle}"
                Command="{x:Bind ViewModel.SignupCommand, Mode=OneWay}"
                Content="انشئ حساب جديد" />
            <Button 
                Style="{StaticResource StretchButtonStyle}"
                Click="OnLoginButtonClick"
                Content="لديك حساب؟ سجل دخول" />            
        </StackPanel>

        <Grid
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
            <ProgressRing 
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                IsIndeterminate="True" />
        </Grid>
    </Grid>
</Page>
