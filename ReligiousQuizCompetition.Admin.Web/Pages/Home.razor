@page "/"
@using Admin.Web.Services
@using Admin.Shared.Models
@using ReligiousQuizCompetition.Admin.Web.Components
@inject NavigationManager Nav
@inject AuthService AuthService
@inject QuizService QuizService

<PageTitle>Home -- Admin</PageTitle>

@if (!IsBusy)
{
    <div class="responsive-table p-3" style="margin-top: 60px;">
        <table class="table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Questions</th>
                    <th>Creation date</th>
                    <th>Expiration date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var quiz in Quizzes)
                {
                    <tr>
                        <td>@quiz.Id</td>
                        <td>
                            <NavLink class="btn btn-outline-primary" href="@($"questions?quizid={quiz.Id}")">عرض الاسئلة</NavLink>
                        </td>
                        <td>@quiz.CreationDate</td>
                        <td>@quiz.ExpirationDate</td>
                        <td>
                            <NavLink class="btn btn-primary" href="@($"update?quizid={quiz.Id}")">تحديث</NavLink>
                        </td>
                        <td>
                            <button class="btn btn-danger" @onclick="() => OnDeleteButtonClick(quiz.Id)">مسح</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    if (!string.IsNullOrEmpty(ErrorMsg))
    {
        <div>@ErrorMsg</div>
    }

    <ContentDialog @ref="DeleteAlert" OnConfirm="DeleteConfirmation">
        هل انت متاكد من انك تريد مسح هذه الاسئلة
    </ContentDialog>
}
else
{
    <div class="position-absolute top-50 start-50 translate-middle text-center">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}

@code {
    private List<Quiz> Quizzes { get; set; } = [];
    private bool IsBusy { get; set; }
    private string ErrorMsg { get; set; }
    private ContentDialog DeleteAlert { get; set; }

    protected override async Task OnInitializedAsync()
    {
        IsBusy = true;

        var response = await AuthService.VerifyAdminUserAsync();
        AdminStatus.IsLoggedIn = response.Data;

        if (!AdminStatus.IsLoggedIn)
        {
            IsBusy = false;
            Nav.NavigateTo("/login");
            return;
        }

        await LoadQuizzesAsync();

        IsBusy = false;
    }

    private async Task LoadQuizzesAsync()
    {
        ErrorMsg = null;

        var quizzesResponse = await QuizService.GetQuizzesAsync();
        if (!quizzesResponse.IsSuccess)
        {
            ErrorMsg = quizzesResponse.ErrorMessage;
            return;
        }

        Quizzes = quizzesResponse.Data;
    }

    private int _quizIdToDelete;

    private async Task DeleteConfirmation()
    {
        ErrorMsg = null;

        IsBusy = true;

        var quizzesResponse = await QuizService.DeleteQuiz(_quizIdToDelete);
        if (!quizzesResponse.IsSuccess)
        {
            IsBusy = false;
            ErrorMsg = quizzesResponse.ErrorMessage;
            return;
        }

        await LoadQuizzesAsync();

        IsBusy = false;
    }

    private async Task OnDeleteButtonClick(int id)
    {
        _quizIdToDelete = id;
        DeleteAlert.Show();
    }
}