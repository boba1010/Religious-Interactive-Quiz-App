@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background: rgba(0,0,0,0.5);" dir="rtl">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content text-end">
                <div class="modal-header d-flex justify-content-between align-items-center">
                    <h5 class="modal-title fw-bold">@Title</h5>
                    <button type="button" class="btn-close m-0" @onclick="Close" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @ChildContent
                </div>
                <div class="modal-footer d-flex justify-content-start gap-2">
                    <button type="button" class="btn btn-primary" @onclick="Confirm">تأكيد</button>
                    <button type="button" class="btn btn-secondary" @onclick="Close">إلغاء</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Title { get; set; } = "تنبيه";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    private bool IsVisible { get; set; } = false;

    public void Show() { IsVisible = true; StateHasChanged(); }
    public void Close() { IsVisible = false; StateHasChanged(); }

    private async Task Confirm()
    {
        await OnConfirm.InvokeAsync();
        Close();
    }
}
