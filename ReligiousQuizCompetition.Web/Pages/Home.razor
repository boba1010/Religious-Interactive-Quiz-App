@page "/"
@using ReligiousQuizCompetition.Web.Components
@using Shared.Services
@using Services
@inject AuthService AuthService
@inject ILocalStorage LocalStorage

<PageTitle>Home</PageTitle>

<div class="row g-4 p-3 h-100 mt-5">
    <div class="col-lg-4">
        <QuizCard />
    </div>
    <div class="col-lg-4">
        <HighestScoreCard />
    </div>
    <div class="col-lg-4">
        <RanksCard />
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var response = await AuthService.VerifyUserAsync();
        Console.WriteLine($"Success: {response.IsSuccess}");
        Console.WriteLine($"Success: {response.Data}");
        UserStatus.IsLoggedIn = response.Data;
    }
}